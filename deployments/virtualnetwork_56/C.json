{"metadata":"{\"defaultCompiler\":{\"version\":\"0.8.20\"},\"sources\":{\"contracts/test/C.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity ^0.8.0;\\r\\n\\r\\ncontract C {\\r\\n    event Calldata(bytes data);\\r\\n\\r\\n    function callC() external {\\r\\n        bytes memory data;\\r\\n        assembly {\\r\\n            let size := calldatasize()\\r\\n            data := mload(0x40) // punta all'inizio della free memory\\r\\n            mstore(data, size) // scrive la lunghezza all'inizio (standard per bytes)\\r\\n\\r\\n            let ptr := add(data, 0x20) // salta il primo word (lunghezza)\\r\\n            calldatacopy(ptr, 0, size) // copia tutta la calldata da offset 0\\r\\n\\r\\n            mstore(0x40, add(ptr, size)) // aggiorna la free memory pointer\\r\\n        }\\r\\n\\r\\n        emit Calldata(data);\\r\\n    }\\r\\n}\\r\\n\",\"versionPragma\":\"^0.8.0\"}}}","address":"0x480ca3a5162b4e41e1D3D320Ad3CF527eC20635C","bytecode":"","deployedBytecode":"","abi":[{"anonymous":false,"inputs":[{"indexed":false,"internalType":"bytes","name":"data","type":"bytes"}],"name":"Calldata","type":"event"},{"inputs":[],"name":"callC","outputs":[],"stateMutability":"nonpayable","type":"function"}]}