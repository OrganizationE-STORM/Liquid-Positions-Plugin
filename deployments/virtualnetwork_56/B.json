{"metadata":"{\"defaultCompiler\":{\"version\":\"0.8.20\"},\"sources\":{\"contracts/test/B.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity ^0.8.0;\\r\\n\\r\\ninterface IC {\\r\\n    function callC() external;\\r\\n}\\r\\n\\r\\ncontract B {\\r\\n    address public c;\\r\\n    event Calldata(bytes data);\\r\\n\\r\\n    constructor(address _c) {\\r\\n        c = _c;\\r\\n    }\\r\\n\\r\\n    function callB(uint256 x) external {\\r\\n        emit Calldata(msg.data); // Qui analizziamo cosa arriva\\r\\n        IC(c).callC();\\r\\n    }\\r\\n}\\r\\n\",\"versionPragma\":\"^0.8.0\"}}}","address":"0x12224b5ba7D549795c09E981dAE51512B5782ABb","bytecode":"","deployedBytecode":"","abi":[{"inputs":[{"internalType":"address","name":"_c","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"bytes","name":"data","type":"bytes"}],"name":"Calldata","type":"event"},{"inputs":[],"name":"c","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"x","type":"uint256"}],"name":"callB","outputs":[],"stateMutability":"nonpayable","type":"function"}]}